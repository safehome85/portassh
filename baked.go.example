package main

// TEMPLATE: copy to baked.go (it is gitignored — private keys must never
// reach the repository) and fill in your own values.
//
// Key generation:
//   ssh-keygen -t ed25519 -N '' -f relay_ed25519 -C portassh-relay
//   ssh-keygen -t ed25519 -N '' -f host_ed25519  -C portassh-host
//   base64 < relay_ed25519  -> relayPrivKeyB64  (private tunnel key)
//   base64 < host_ed25519   -> serverHostKeyB64 (private server host key)
//
// Relay setup (any SSH server, e.g. a VPS):
//   1. useradd -m -s /bin/sh portassh
//   2. echo "$(cat relay_ed25519.pub)" > /home/portassh/.ssh/authorized_keys
//   3. ssh-keyscan -t ed25519 <relay-ip>  -> first part of relayHostKeyLine
//
// Client key (allowedClientPubKey): the line from ~/.ssh/id_ed25519.pub of
// the machine you will connect FROM.

const (
	defaultRelay     = "YOUR_RELAY_HOST[:22]"
	defaultRelayUser = "portassh"
	defaultLPort     = 2222
	defaultRPort     = 2200

	// private ed25519 tunnel key, base64 (PKCS8/OpenSSH PEM)
	relayPrivKeyB64 = "BASE64_PRIVATE_KEY"

	// relay host key in known_hosts format: "host ssh-ed25519 AAAA..."
	relayHostKeyLine = "RELAY_IP ssh-ed25519 AAAA..."

	// private host key of the embedded SSH server, base64
	serverHostKeyB64 = "BASE64_HOST_KEY"
	serverHostPub    = "ssh-ed25519 AAAA... (for client known_hosts)"

	// the only client key accepted by the embedded server
	allowedClientPubKey = "ssh-ed25519 AAAA... you@client"

	// password auth for connecting from machines without this key
	// (empty = password auth disabled). Generate: openssl rand -base64 15
	allowedClientPassword = "YOUR_CLIENT_PASSWORD"
)
